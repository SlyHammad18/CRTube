{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRTube",
  "version": "0.2.0",
  "identifier": "io.github.slyhammad18.crtube",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbs/**", "$APPDATA/bin/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Download YouTube audio and video to your machine.",
    "longDescription": "CRTube is a desktop client for downloading YouTube videos and audio with yt-dlp. Search, pick a format, and queue downloads with live progress — all processed locally with no telemetry.",
    "publisher": "SlyHammad18",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
